# Environment Variables Example

# Database Connection (Prisma)
# Replace with your actual database URL (PostgreSQL/MySQL/etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/aurum_db?schema=public"

# Authentication
# This secret is used to sign both main session JWTs and temporary file-view signatures.
# In production, use a long, random string.
JWT_SECRET="your-secure-stable-secret-key-change-it"

# Application Settings
PORT=3000
NODE_ENV=development

# Super Admin Authorization (Comma-separated emails allowed to perform system-wide full DB backups)
# SUPER_ADMIN_EMAILS="admin@example.com,owner@example.com"

# ─── Cloudflare R2 / S3 Storage ──────────────────────────────────────────
# Endpoint for Cloudflare R2 follows the pattern: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_REGION="auto"
R2_BUCKET="aurum-assets"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# The public custom domain or r2.dev domain used to serve files
R2_PUBLIC_URL="https://assets.sarafa-bazar.com"
