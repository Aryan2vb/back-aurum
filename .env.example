# Environment Variables Example

# Database Connection (Prisma)
# Replace with your actual database URL (PostgreSQL/MySQL/etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/aurum_db?schema=public"

# Authentication
# This secret is used to sign both main session JWTs and temporary file-view signatures.
# In production, use a long, random string.
JWT_SECRET="your-secure-stable-secret-key-change-it"

# Application Settings
PORT=3000
NODE_ENV=development
