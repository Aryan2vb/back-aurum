generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  /// Matches Supabase auth.users.id (UUID string)
  id                   String                   @id
  email                String                   @unique
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  passwordHash         String?
  mfaEnabled           Boolean                  @default(false)
  fullName             String?
  accountsCreated      Account[]
  auditLogsPerformed   AuditLog[]
  customersCreated     Customer[]
  invoicesCreated      Invoice[]
  ledgerEntriesCreated LedgerEntry[]            @relation("LedgerCreatedBy")
  invitationsCreated   OrganizationInvitation[]
  members              OrganizationMember[]
  sessions             Session[]
}

model Organization {
  id                 String                   @id @default(uuid())
  name               String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  nextCustomerNumber Int                      @default(1)
  deletedAt          DateTime?
  locale             String                   @default("en-US")
  status             OrganizationStatus       @default(ACTIVE)
  timezone           String                   @default("UTC")
  accounts           Account[]
  auditLogs          AuditLog[]
  contactDetails     ContactDetail[]
  customers          Customer[]
  documents          Document[]
  invoices           Invoice[]
  invoiceItems       InvoiceItem[]
  invoicePayments    InvoicePayment[]
  invoiceSequences   InvoiceSequence[]
  ledgerEntries      LedgerEntry[]
  locations          Location[]
  metaTrackings      MetaTracking[]
  invoiceSettings    OrgInvoiceSettings?
  accessPolicy       OrgAccessPolicy?
  invitations        OrganizationInvitation[]
  members            OrganizationMember[]
  sessions           Session[]
  socialContexts     SocialContext[]
  vendors            Vendor[]
  stockBalances      StockBalance[]
  stockLedgers       StockLedger[]
  metalPurities      OrgMetalPurity[]
  purchaseInvoices   PurchaseInvoice[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchasePayments   PurchasePayment[]
  financialAccounts FinancialAccount[]
  financialTransactions FinancialTransaction[]
  financialMovements FinancialMovement[]
  bankStatementImports BankStatementImport[]
  bankStatementLines   BankStatementLine[]

  @@index([status])
  @@index([deletedAt])
}

/// Owner-defined login/API window + which modules ADMIN/STAFF/VIEWER may open.
/// OWNER is always exempt from the window and always has every module.
model OrgAccessPolicy {
  organizationId      String       @id
  /// When true, non-OWNER members may only login/call APIs between start–end (org timezone).
  accessWindowEnabled Boolean      @default(false)
  /// HH:mm in organization.timezone (inclusive start).
  accessWindowStart   String       @default("09:00")
  /// HH:mm in organization.timezone (exclusive end). Supports overnight (e.g. 22:00→06:00).
  accessWindowEnd     String       @default("20:00")
  /// module -> roles allowed (ADMIN|STAFF|VIEWER). Missing module = all three allowed.
  moduleAccess        Json         @default("{}")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationMember {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(STAFF)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole @default(STAFF)
  token          String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      User?            @relation(fields: [createdById], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
}

model Session {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([organizationId, userId])
}

model Customer {
  id             String          @id @default(uuid())
  organizationId String
  customerCode   String
  fullName       String
  gstin          String?
  fatherName     String?
  motherName     String?
  spouseName     String?
  dateOfBirth    DateTime?
  isDobEstimated Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?
  deletedAt      DateTime?
  gender         Gender?
  status         CustomerStatus  @default(ACTIVE)
  accounts       Account[]
  contactDetails ContactDetail[]
  createdBy      User?           @relation(fields: [createdById], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]
  invoices       Invoice[]
  ledgers        LedgerEntry[]
  locations      Location[]
  metaTrackings  MetaTracking[]
  socialContexts SocialContext[]
  udharEntries   UdharEntry[]

  @@unique([organizationId, customerCode])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerCode])
  @@index([createdById])
  @@index([deletedAt])
  @@index([organizationId, deletedAt])
}

model ContactDetail {
  id                     String          @id @default(uuid())
  customerId             String
  organizationId         String
  primaryPhone           String
  secondaryPhone         String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  deletedAt              DateTime?
  phoneOwnerType         PhoneOwnerType?
  preferredContactMethod ContactMethod?
  customer               Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, primaryPhone])
  @@index([organizationId])
  @@index([primaryPhone])
  @@index([customerId])
  @@index([deletedAt])
}

model Location {
  id             String       @id @default(uuid())
  customerId     String
  organizationId String
  village        String?
  tehsil         String?
  district       String?
  state          String?
  pincode        String?
  landmark       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, tehsil])
  @@index([organizationId, district])
  @@index([organizationId, village])
  @@index([customerId])
  @@index([deletedAt])
}

model SocialContext {
  id             String       @id @default(uuid())
  customerId     String
  organizationId String
  caste          String?
  educationLevel String?
  occupation     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  incomeRange    IncomeRange?
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@index([deletedAt])
}

model Document {
  id             String       @id @default(uuid())
  customerId     String
  organizationId String
  aadharNumber   String?      @db.Char(12)
  aadharVerified Boolean      @default(false)
  panNumber      String?      @db.Char(10)
  panVerified    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, aadharNumber])
  @@unique([organizationId, panNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([deletedAt])
}

model Account {
  id             String        @id @default(uuid())
  customerId     String
  organizationId String
  openingBalance Decimal       @default(0) @db.Decimal(12, 2)
  openedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  deletedAt      DateTime?
  status         AccountStatus @default(ACTIVE)
  createdBy      User?         @relation(fields: [createdById], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([createdById])
  @@index([deletedAt])
}

model MetaTracking {
  id             String       @id @default(uuid())
  customerId     String
  organizationId String
  registeredOn   DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  source         String?
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, source])
  @@index([organizationId, registeredOn])
  @@index([customerId])
  @@index([deletedAt])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         AuditAction
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, action])
  @@index([organizationId, entityType])
  @@index([organizationId, entityId])
  @@index([userId])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model LedgerEntry {
  id                     String         @id @default(uuid())
  organizationId         String
  customerId             String
  amount                 Decimal        @db.Decimal(12, 2)
  type                   LedgerType
  description            String?
  /// ID of the related entity (Invoice ID, UdharEntry ID, AdvanceEntry ID, etc.)
  entityId               String?
  /// For ADVANCE_TRANSFER_OUT/IN pairs — points to the counterpart LedgerEntry id.
  /// For ADVANCE_APPLIED — points to the UdharEntry being offset.
  /// For ADVANCE_REFUND  — points to the source ADVANCE_RECEIVED LedgerEntry id.
  referenceLedgerEntryId String?
  /// Direct invoice FK for ADVANCE_APPLIED entries — enables fast advance lookup per invoice.
  invoiceId              String?
  /// Payment method stored on ADVANCE_RECEIVED / ADVANCE_REFUND entries.
  paymentMethod          PaymentMethod?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?
  createdById            String?
  accountId              String?
  createdBy              User?          @relation("LedgerCreatedBy", fields: [createdById], references: [id])
  customer               Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  udharEntry             UdharEntry?
  financialAccount       FinancialAccount? @relation(fields: [accountId], references: [id])

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, customerId])
  @@index([type])
  @@index([createdAt])
  @@index([organizationId, customerId, type])
  @@index([invoiceId])
  @@index([accountId])
}

model UdharEntry {
  id                String             @id @default(uuid())
  organizationId    String
  customerId        String
  ledgerEntryId     String             @unique
  /// Optional link to an invoice
  invoiceId         String?
  amount            Decimal            @db.Decimal(12, 2)
  paidAmount        Decimal            @default(0) @db.Decimal(12, 2)
  dueDate           DateTime?
  status            CreditStatus       @default(ACTIVE)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  nextReminderDate  DateTime?
  reminderFrequency ReminderFrequency?
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice           Invoice?           @relation(fields: [invoiceId], references: [id])
  ledgerEntry       LedgerEntry        @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
}

/// One-time GST + company details per organisation.
/// Stored as a snapshot on each Invoice for immutability.
model OrgInvoiceSettings {
  id                  String       @id @default(uuid())
  organizationId      String       @unique
  companyName         String
  address             String
  gstin               String
  state               String
  stateCode           String
  phone               String?
  email               String?
  pan                 String?
  mantra              String?
  logoUrl             String?
  bisLogoUrl          String?
  bankName            String?
  bankBranch          String?
  bankAccountName     String?
  bankAccountNumber   String?
  bankIfsc            String?
  defaultTaxType      TaxType      @default(CGST_SGST)
  defaultCgstRate     Decimal      @default(1.5) @db.Decimal(5, 2)
  defaultSgstRate     Decimal      @default(1.5) @db.Decimal(5, 2)
  defaultIgstRate     Decimal      @default(0) @db.Decimal(5, 2)
  defaultTemplate     String       @default("standard")
  invoiceNumberPrefix String?      @default("INV")
  startingSequence    Int          @default(1)
  declaration         String?
  termsOfDelivery     String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  /// URL of the UPI / payment QR code image stored in R2
  qrCodeUrl           String?
  /// URL of the authorized signatory image stored in R2
  signatureUrl        String?
  footerImageUrl      String?
  whatsappGroupQrUrl  String?
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                      String           @id @default(uuid())
  organizationId          String
  customerId              String
  invoiceNumber           String?
  status                  InvoiceStatus    @default(DRAFT)
  taxType                 TaxType          @default(CGST_SGST)
  subtotal                Decimal          @db.Decimal(14, 4)
  cgstRate                Decimal          @default(0) @db.Decimal(5, 2)
  sgstRate                Decimal          @default(0) @db.Decimal(5, 2)
  igstRate                Decimal          @default(0) @db.Decimal(5, 2)
  cgstAmount              Decimal          @default(0) @db.Decimal(12, 2)
  sgstAmount              Decimal          @default(0) @db.Decimal(12, 2)
  igstAmount              Decimal          @default(0) @db.Decimal(12, 2)
  roundOff                Decimal          @default(0) @db.Decimal(6, 2)
  totalAmount             Decimal          @db.Decimal(14, 2)
  paidAmount              Decimal          @default(0) @db.Decimal(12, 2)
  companySnapshot         Json
  buyerSnapshot           Json?
  modeOfPayment           String?
  deliveryNote            String?
  dispatchDocNo           String?
  destination             String?
  termsOfDelivery         String?
  templateType            String           @default("standard")
  invoiceDate             DateTime         @default(now())
  financialYear           String?
  notes                   String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  createdById             String?
  deletedAt               DateTime?
  sequence                Int?
  discountAmount          Decimal?         @db.Decimal(12, 2)
  isNegotiated            Boolean          @default(false)
  metalRateDate           DateTime?
  metalRateSource         String?
  negotiatedBy            String?
  negotiationNote         String?
  originalCgstAmount      Decimal?         @db.Decimal(12, 2)
  originalGrandTotal      Decimal?         @db.Decimal(14, 2)
  originalIgstAmount      Decimal?         @db.Decimal(12, 2)
  originalSgstAmount      Decimal?         @db.Decimal(12, 2)
  originalSubtotal        Decimal?         @db.Decimal(14, 4)
  originalTaxableAmount   Decimal?         @db.Decimal(14, 4)
  placeOfSupply           String?
  taxableAmount           Decimal?         @db.Decimal(14, 4)
  totalHallmarkingCharges Decimal          @default(0) @db.Decimal(12, 2)
  createdBy               User?            @relation(fields: [createdById], references: [id])
  customer                Customer         @relation(fields: [customerId], references: [id])
  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items                   InvoiceItem[]
  payments                InvoicePayment[]
  udharEntries            UdharEntry[]

  @@unique([organizationId, invoiceNumber])
  @@unique([organizationId, financialYear, sequence])
  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, status])
  @@index([organizationId, invoiceDate])
  @@index([organizationId, status, invoiceDate])
  @@index([createdById])
  @@index([deletedAt])
}

model InvoiceItem {
  id                          String             @id @default(uuid())
  invoiceId                   String
  organizationId              String
  slNo                        Int
  description                 String
  hsnSac                      String
  quantity                    Decimal            @db.Decimal(10, 3)
  unit                        String             @default("PCS")
  unitPrice                   Decimal            @db.Decimal(12, 4)
  makingCharges               Decimal?           @db.Decimal(10, 4)
  taxableAmount               Decimal            @db.Decimal(14, 4)
  totalAmount                 Decimal            @db.Decimal(14, 4)
  grossWeight                 Decimal?           @db.Decimal(10, 3)
  netWeight                   Decimal?           @db.Decimal(10, 3)
  purity                      String?
  huid                        String?
  metalType                   MetalType          @default(GOLD)
  effectiveRate               Decimal?           @db.Decimal(12, 4)
  hallmarkingCharge           Decimal            @default(0) @db.Decimal(8, 2)
  isHallmarked                Boolean            @default(false)
  makingChargesAmount         Decimal?           @db.Decimal(12, 4)
  makingChargesType           MakingChargesType? @default(PER_GRAM)
  metalRate                   Decimal?           @db.Decimal(12, 4)
  originalItemAmount          Decimal?           @db.Decimal(12, 4)
  originalMakingCharges       Decimal?           @db.Decimal(10, 4)
  originalMakingChargesAmount Decimal?           @db.Decimal(12, 4)
  purityBasis                 Int?
  purityLabel                 String?
  purityValue                 Decimal?           @db.Decimal(8, 3)
  stoneCharges                Decimal?           @default(0) @db.Decimal(12, 4)
  stoneWeight                 Decimal?           @default(0) @db.Decimal(10, 3)
  originalEffectiveRate       Decimal?           @db.Decimal(12, 4)
  originalMetalRate           Decimal?           @db.Decimal(12, 4)
  invoice                     Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization                Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([organizationId])
  @@index([organizationId, metalType])
}

model InvoiceSequence {
  id             String       @id @default(uuid())
  organizationId String
  financialYear  String
  nextSequence   Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, financialYear])
  @@index([organizationId])
}

model InvoicePayment {
  id             String        @id @default(uuid())
  invoiceId      String
  organizationId String
  mode           PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  reference      String?
  paidAt         DateTime      @default(now())
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accountId      String?
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount? @relation(fields: [accountId], references: [id])

  @@index([invoiceId])
  @@index([organizationId])
  @@index([organizationId, mode])
  @@index([organizationId, paidAt])
  @@index([organizationId, mode, paidAt])
  @@index([accountId])
}

model SystemConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@index([key])
}

enum OrganizationRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  CLOSED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AccountStatus {
  ACTIVE
  CLOSED
  SUSPENDED
  DORMANT
}

enum PhoneOwnerType {
  SELF
  FAMILY
  NEIGHBOR
  OTHER
}

enum ContactMethod {
  CALL
  WHATSAPP
  SMS
  VISIT
  EMAIL
}

enum IncomeRange {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum CreditStatus {
  ACTIVE
  PAID
  OVERDUE
  CANCELLED
}

enum ReminderFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
  NEFT
  RTGS
  IMPS
  OLD_GOLD
  CREDIT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  UNPAID
  CANCELLED
  CONFIRMED
}

enum TaxType {
  CGST_SGST
  IGST
  NONE
}

enum MetalType {
  GOLD
  SILVER
  PLATINUM
}

enum MakingChargesType {
  PER_GRAM
  FLAT_PER_ITEM
  PERCENTAGE_ON_METAL
}

enum LedgerType {
  UDHAR
  PAYMENT
  ADJUSTMENT
  RETURN
  // ── Advance / credit system ──────────────────────────────────────────────
  /// Customer deposits money before an invoice is raised.
  ADVANCE_RECEIVED
  /// Advance balance consumed against a specific invoice / UdharEntry.
  ADVANCE_APPLIED
  /// Advance moved OUT from this customer to another.
  ADVANCE_TRANSFER_OUT
  /// Advance moved IN to this customer from another.
  ADVANCE_TRANSFER_IN
  /// Advance balance returned to the customer in cash / UPI / etc.
  ADVANCE_REFUND
}

enum StockTransactionType {
  OPENING_BALANCE
  PURCHASE
  SALE
  ADJUSTMENT
}

model Vendor {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  gstin          String?
  address        String?
  stateCode      String?
  stateName      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases    PurchaseInvoice[]

  @@index([organizationId])
}

model OrgMetalPurity {
  id             String    @id @default(uuid())
  organizationId String
  metalType      MetalType
  label          String
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metalType, label])
  @@index([organizationId, metalType, isActive])
}

model StockBalance {
  id             String    @id @default(uuid())
  organizationId String
  metalType      MetalType
  purity         String
  quantity       Decimal   @default(0) @db.Decimal(10, 3)
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metalType, purity])
  @@index([organizationId])
}

model StockLedger {
  id              String               @id @default(uuid())
  organizationId  String
  date            DateTime             @default(now())
  metalType       MetalType
  purity          String
  transactionType StockTransactionType
  quantityIn      Decimal              @default(0) @db.Decimal(10, 3)
  quantityOut     Decimal              @default(0) @db.Decimal(10, 3)
  runningBalance  Decimal              @db.Decimal(10, 3)
  rate            Decimal?             @db.Decimal(12, 4)
  totalValue      Decimal?             @db.Decimal(14, 4)
  referenceId     String?
  notes           String?

  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metalType, purity])
  @@index([organizationId, date])
}

model PurchaseInvoice {
  id             String    @id @default(uuid())
  organizationId String
  vendorId       String?
  invoiceNumber  String?
  billSeries     String?
  vendorName       String?
  vendorGstin      String?
  vendorStateCode  String?
  vendorStateName  String?
  purchaseDate   DateTime  @default(now())
  dueDate        DateTime?
  metalType      MetalType
  purity         String
  totalWeight    Decimal   @db.Decimal(10, 3)
  rate           Decimal?  @db.Decimal(12, 4)
  totalAmount    Decimal?  @db.Decimal(14, 2)
  taxableAmount  Decimal?  @db.Decimal(14, 2)
  taxType        TaxType   @default(CGST_SGST)
  cgstRate       Decimal   @default(1.5) @db.Decimal(5, 2)
  sgstRate       Decimal   @default(1.5) @db.Decimal(5, 2)
  igstRate       Decimal   @default(0) @db.Decimal(5, 2)
  cgstAmount     Decimal   @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal   @default(0) @db.Decimal(12, 2)
  igstAmount     Decimal   @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal?  @db.Decimal(14, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(14, 2)
  status         PurchaseStatus @default(UNPAID)
  addGst         Boolean   @default(false)
  gstInclusive   Boolean   @default(false)
  totalGoldWeight Decimal  @default(0) @db.Decimal(10, 3)
  totalSilverWeight Decimal @default(0) @db.Decimal(10, 3)
  totalMetalAmount Decimal  @default(0) @db.Decimal(14, 2)
  totalHallmarkingCharges Decimal @default(0) @db.Decimal(12, 2)
  totalOtherCharges Decimal @default(0) @db.Decimal(12, 2)
  adjustment     Decimal   @default(0) @db.Decimal(12, 2)
  notes          String?
  /// Optional scrap bill / supplier invoice (PDF or photo) stored in R2
  attachmentUrl  String?
  attachmentKey  String?
  attachmentName String?
  attachmentMime String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        PurchaseInvoiceItem[]
  payments     PurchasePayment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
}

model PurchaseInvoiceItem {
  id                String    @id @default(uuid())
  purchaseInvoiceId String
  organizationId    String
  slNo              Int
  itemName          String?
  metalType         MetalType
  purity            String
  grossWeight       Decimal   @db.Decimal(10, 3)
  netWeight         Decimal   @db.Decimal(10, 3)
  rate              Decimal?  @db.Decimal(12, 4)
  hallmarkingCharge Decimal   @default(0) @db.Decimal(8, 2)
  otherCharges      Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal   @db.Decimal(14, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([purchaseInvoiceId])
  @@index([organizationId])
  @@index([organizationId, metalType, purity])
}

model PurchasePayment {
  id                 String        @id @default(uuid())
  purchaseInvoiceId  String
  organizationId     String
  mode               PaymentMethod
  amount             Decimal       @db.Decimal(12, 2)
  reference          String?
  paidAt             DateTime      @default(now())
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  accountId          String?

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount? @relation(fields: [accountId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([organizationId])
  @@index([organizationId, mode])
  @@index([organizationId, paidAt])
  @@index([accountId])
}

model FinancialAccount {
  id             String                 @id @default(uuid())
  organizationId String
  name           String
  type           FinancialAccountType
  status         FinancialAccountStatus @default(ACTIVE)
  isDefault      Boolean                @default(false)
  bankName       String?
  accountNumber  String?
  ifsc           String?
  notes          String?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements      FinancialMovement[]
  invoicePayments InvoicePayment[]
  ledgerEntries  LedgerEntry[]
  purchasePayments PurchasePayment[]
  bankStatementImports BankStatementImport[]
  bankStatementLines   BankStatementLine[]

  @@unique([organizationId, name])
  @@index([organizationId, type, status])
  @@index([organizationId, isDefault])
}

model BankStatementImport {
  id             String              @id @default(uuid())
  organizationId String
  accountId      String
  filename       String
  importedAt     DateTime            @default(now())
  rowCount       Int                 @default(0)
  creditCount    Int                 @default(0)
  debitCount     Int                 @default(0)
  newCount       Int                 @default(0)
  skippedCount   Int                 @default(0)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        FinancialAccount    @relation(fields: [accountId], references: [id])
  lines          BankStatementLine[]

  @@index([organizationId, importedAt])
  @@index([accountId])
}

model BankStatementLine {
  id               String                  @id @default(uuid())
  organizationId   String
  importId         String
  accountId        String
  txnDate          DateTime
  valueDate        DateTime?
  narration        String
  debit            Decimal                 @db.Decimal(14, 2)
  credit           Decimal                 @db.Decimal(14, 2)
  refNumber        String?
  closingBalance   Decimal?                @db.Decimal(14, 2)
  fingerprint      String
  status           BankStatementLineStatus @default(UNMATCHED)
  matchedInvoiceId String?
  invoicePaymentId String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  import           BankStatementImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  account          FinancialAccount        @relation(fields: [accountId], references: [id])

  @@unique([organizationId, accountId, fingerprint])
  @@index([organizationId, status])
  @@index([organizationId, accountId, status])
  @@index([organizationId, invoicePaymentId])
  @@index([organizationId, status, invoicePaymentId])
  @@index([importId])
}

model FinancialTransaction {
  id               String                   @id @default(uuid())
  organizationId   String
  type             FinancialTransactionType
  sourceType       String
  sourceId         String
  sourceParentType String?
  sourceParentId   String?
  description      String?
  reference        String?
  paymentMethod    PaymentMethod?
  occurredAt       DateTime                 @default(now())
  createdById      String?
  reversedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements        FinancialMovement[]

  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, sourceParentType, sourceParentId])
  @@index([organizationId, reversedAt])
}

model FinancialMovement {
  id             String               @id @default(uuid())
  organizationId String
  transactionId  String
  accountId      String?
  amount         Decimal              @db.Decimal(14, 2)
  description    String?
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction    FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account        FinancialAccount?    @relation(fields: [accountId], references: [id])

  @@index([organizationId, accountId])
  @@index([transactionId])
}

enum PurchaseStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum FinancialAccountType {
  CASH
  BANK
}

enum FinancialAccountStatus {
  ACTIVE
  INACTIVE
}

enum FinancialTransactionType {
  OPENING_BALANCE
  SALE_RECEIPT
  UDHAR_COLLECTION
  ADVANCE_RECEIPT
  ADVANCE_REFUND
  PURCHASE_PAYMENT
  CASH_BANK_TRANSFER
  BANK_BANK_TRANSFER
  ADJUSTMENT
}

enum BankStatementLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}
