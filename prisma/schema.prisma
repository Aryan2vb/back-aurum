generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  /// Matches Supabase auth.users.id (UUID string)
  id                        String                   @id
  email                     String                   @unique
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  passwordHash              String?
  fullName                  String?
  accountsCreated           Account[]
  auditLogsPerformed        AuditLog[]
  customersCreated          Customer[]
  invoicesCreated           Invoice[]
  ledgerEntriesCreated      LedgerEntry[]            @relation("LedgerCreatedBy")
  invitationsCreated        OrganizationInvitation[]
  members                   OrganizationMember[]
  sessions                  Session[]
}

model Organization {
  id                 String                   @id @default(uuid())
  name               String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?
  locale             String                   @default("en-US")
  status             OrganizationStatus       @default(ACTIVE)
  timezone           String                   @default("UTC")
  nextCustomerNumber Int                      @default(1)
  accounts           Account[]
  auditLogs          AuditLog[]
  contactDetails     ContactDetail[]
  customers          Customer[]
  documents          Document[]
  invoices           Invoice[]
  invoiceItems       InvoiceItem[]
  invoiceSequences   InvoiceSequence[]
  locations          Location[]
  metaTrackings      MetaTracking[]
  invoiceSettings    OrgInvoiceSettings?
  invitations        OrganizationInvitation[]
  members            OrganizationMember[]
  sessions           Session[]
  socialContexts     SocialContext[]
  ledgerEntries      LedgerEntry[]

  @@index([status])
  @@index([deletedAt])
}

model OrganizationMember {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  role           OrganizationRole @default(STAFF)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole @default(STAFF)
  token          String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      User?            @relation(fields: [createdById], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
}

model Session {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([organizationId, userId])
}

model Customer {
  id             String          @id @default(uuid())
  organizationId String
  customerCode   String
  fullName       String
  fatherName     String?
  motherName     String?
  spouseName     String?
  dateOfBirth    DateTime?
  isDobEstimated Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?
  deletedAt      DateTime?
  gender         Gender?
  status         CustomerStatus  @default(ACTIVE)
  accounts       Account[]
  contactDetails ContactDetail[]
  createdBy      User?           @relation(fields: [createdById], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]
  invoices       Invoice[]
  ledgers        LedgerEntry[]
  udharEntries   UdharEntry[]
  metaTrackings  MetaTracking[]
  socialContexts SocialContext[]
  locations      Location[]

  @@unique([organizationId, customerCode])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerCode])
  @@index([createdById])
  @@index([deletedAt])
  @@index([organizationId, deletedAt])
}

model ContactDetail {
  id                     String          @id @default(uuid())
  customerId             String
  organizationId         String
  primaryPhone           String
  secondaryPhone         String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  deletedAt              DateTime?
  phoneOwnerType         PhoneOwnerType?
  preferredContactMethod ContactMethod?
  customer               Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, primaryPhone])
  @@index([organizationId])
  @@index([primaryPhone])
  @@index([customerId])
  @@index([deletedAt])
}

model Location {
  id             String       @id @default(uuid())
  customerId     String
  organizationId String
  village        String?
  tehsil         String?
  district       String?
  state          String?
  pincode        String?
  landmark       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, tehsil])
  @@index([organizationId, district])
  @@index([organizationId, village])
  @@index([customerId])
  @@index([deletedAt])
}

model SocialContext {
  id             String       @id @default(uuid())
  customerId     String
  organizationId String
  caste          String?
  educationLevel String?
  occupation     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  incomeRange    IncomeRange?
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@index([deletedAt])
}

model Document {
  id             String       @id @default(uuid())
  customerId     String
  organizationId String
  aadharLast4    String?      @db.Char(4)
  aadharVerified Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, aadharLast4])
  @@index([organizationId])
  @@index([customerId])
  @@index([deletedAt])
}

model Account {
  id             String        @id @default(uuid())
  customerId     String
  organizationId String
  openingBalance Decimal       @default(0) @db.Decimal(12, 2)
  openedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  deletedAt      DateTime?
  status         AccountStatus @default(ACTIVE)
  createdBy      User?         @relation(fields: [createdById], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([createdById])
  @@index([deletedAt])
}

model MetaTracking {
  id             String       @id @default(uuid())
  customerId     String
  organizationId String
  registeredOn   DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  source         String?
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, source])
  @@index([organizationId, registeredOn])
  @@index([customerId])
  @@index([deletedAt])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         AuditAction
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, action])
  @@index([organizationId, entityType])
  @@index([organizationId, entityId])
  @@index([userId])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}



model LedgerEntry {
  id             String       @id @default(uuid())
  organizationId String
  customerId     String
  amount         Decimal      @db.Decimal(12, 2)
  type           LedgerType
  description    String?
  entityId       String?      /// ID of the related entity (Invoice ID, Payment ID, etc.)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  createdById    String?
  
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("LedgerCreatedBy", fields: [createdById], references: [id])
  udharEntry     UdharEntry?

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, customerId])
  @@index([type])
  @@index([createdAt])
}

model UdharEntry {
  id             String       @id @default(uuid())
  organizationId String
  customerId     String
  ledgerEntryId  String       @unique
  invoiceId      String?      /// Optional link to an invoice
  amount         Decimal      @db.Decimal(12, 2)
  paidAmount     Decimal      @default(0) @db.Decimal(12, 2)
  dueDate        DateTime?
  status         CreditStatus @default(ACTIVE)
  notes          String?
  reminderFrequency ReminderFrequency?
  nextReminderDate  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])
  ledgerEntry    LedgerEntry  @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
}

/// One-time GST + company details per organisation.
/// Stored as a snapshot on each Invoice for immutability.
model OrgInvoiceSettings {
  id                String       @id @default(uuid())
  organizationId    String       @unique
  companyName       String
  address           String
  gstin             String
  state             String
  stateCode         String
  phone             String?
  email             String?
  pan               String?
  mantra            String?
  logoUrl           String?
  bisLogoUrl        String?
  bankName          String?
  bankBranch        String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  defaultTaxType    TaxType      @default(CGST_SGST)
  defaultCgstRate   Decimal      @default(1.5) @db.Decimal(5, 2)
  defaultSgstRate   Decimal      @default(1.5) @db.Decimal(5, 2)
  defaultIgstRate   Decimal      @default(0) @db.Decimal(5, 2)
  defaultTemplate   String       @default("standard")
  invoiceNumberPrefix String?    @default("INV")
  startingSequence  Int          @default(1)
  declaration       String?
  termsOfDelivery   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id              String        @id @default(uuid())
  organizationId  String
  customerId      String
  invoiceNumber   String?
  status          InvoiceStatus @default(DRAFT)
  taxType         TaxType       @default(CGST_SGST)
  subtotal        Decimal       @db.Decimal(12, 2)
  cgstRate        Decimal       @default(0) @db.Decimal(5, 2)
  sgstRate        Decimal       @default(0) @db.Decimal(5, 2)
  igstRate        Decimal       @default(0) @db.Decimal(5, 2)
  cgstAmount      Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount      Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount      Decimal       @default(0) @db.Decimal(12, 2)
  roundOff        Decimal       @default(0) @db.Decimal(6, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  companySnapshot Json
  buyerSnapshot   Json?
  modeOfPayment   String?
  deliveryNote    String?
  dispatchDocNo   String?
  destination     String?
  termsOfDelivery String?
  templateType    String        @default("standard")
  invoiceDate     DateTime      @default(now())
  financialYear   String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?
  deletedAt       DateTime?
  sequence        Int?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items           InvoiceItem[]
  udharEntries    UdharEntry[]

  @@unique([organizationId, invoiceNumber])
  @@unique([organizationId, financialYear, sequence])
  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, status])
  @@index([organizationId, invoiceDate])
  @@index([createdById])
  @@index([deletedAt])
}

model InvoiceItem {
  id             String       @id @default(uuid())
  invoiceId      String
  organizationId String
  slNo           Int
  description    String
  hsnSac         String
  quantity       Decimal      @db.Decimal(10, 3)
  unit           String       @default("PCS")
  unitPrice      Decimal      @db.Decimal(12, 2)
  makingCharges  Decimal?     @db.Decimal(10, 2)
  taxableAmount  Decimal      @db.Decimal(12, 2)
  totalAmount    Decimal      @db.Decimal(12, 2)
  grossWeight    Decimal?     @db.Decimal(10, 3)
  netWeight      Decimal?     @db.Decimal(10, 3)
  purity         String?
  huid           String?
  metalType      MetalType    @default(GOLD)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([organizationId])
}

model InvoiceSequence {
  id             String       @id @default(uuid())
  organizationId String
  financialYear  String
  nextSequence   Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, financialYear])
  @@index([organizationId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  CLOSED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AccountStatus {
  ACTIVE
  CLOSED
  SUSPENDED
  DORMANT
}

enum PhoneOwnerType {
  SELF
  FAMILY
  NEIGHBOR
  OTHER
}

enum ContactMethod {
  CALL
  WHATSAPP
  SMS
  VISIT
  EMAIL
}

enum IncomeRange {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum CreditStatus {
  ACTIVE
  PAID
  OVERDUE
  CANCELLED
}

enum ReminderFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  UNPAID
  CANCELLED
}

enum TaxType {
  CGST_SGST
  IGST
  NONE
}

enum MetalType {
  GOLD
  SILVER
}

enum LedgerType {
  UDHAR
  PAYMENT
  ADJUSTMENT
  RETURN
}
